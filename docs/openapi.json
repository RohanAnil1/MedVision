  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$",
            "title": "Id"
          },
          "series_uid": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Series Uid"
          },
          "instance_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Instance Id"
          },
          "frame": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Frame"
          },
          "tool": {
            "type": "string",
            "enum": [
              "length",
              "angle",
              "cobb",
              "polygon",
              "rectangle",
              "ellipse",
              "text"
            ],
            "title": "Tool"
          },
          "points": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "maxItems": 1024,
            "minItems": 1,
            "title": "Points"
          },
          "units": {
            "type": "string",
            "enum": [
              "mm",
              "pixels"
            ],
            "title": "Units"
          },
          "text": {
            "type": "string",
            "maxLength": 4096,
            "title": "Text",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "id",
          "series_uid",
          "instance_id",
          "frame",
          "tool",
          "points",
          "units"
        ],
        "title": "Annotation"
      },
      "Body_import_files_api_v1_imports_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "format": "binary"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_import_files_api_v1_imports_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ObliqueRequest": {
        "properties": {
          "origin": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "Origin"
          },
          "u": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "U"
          },
          "v": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 3,
            "minItems": 3,
            "title": "V"
          },
          "rows": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Rows",
            "default": 512
          },
          "columns": {
            "type": "integer",
            "maximum": 2048.0,
            "minimum": 1.0,
            "title": "Columns",
            "default": 512
          },
          "spacing": {
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Spacing",
            "default": [
              1,
              1
            ]
          },
          "center": {
            "type": "number",
            "title": "Center",
            "default": 40
          },
          "width": {
            "type": "number",
            "minimum": 1.0,
            "title": "Width",
            "default": 400
          }
        },
        "type": "object",
        "required": [
          "origin",
          "u",
          "v"
        ],
        "title": "ObliqueRequest"
      },
      "StorageRequest": {
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path"
          }
        },
        "type": "object",
        "required": [
          "path"
        ],
        "title": "StorageRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}