  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$",
            "title": "Id"
          },
          "series_uid": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Series Uid"
          },
          "instance_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Instance Id"
          },
          "frame": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Frame"
          },
          "tool": {
            "type": "string",
            "enum": [
              "length",
              "angle",
              "cobb",
              "polygon",
              "rectangle",
              "ellipse",
              "text"
            ],
            "title": "Tool"
          },
          "points": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 3,
              "minItems": 3
            },
            "type": "array",
            "maxItems": 1024,
            "minItems": 1,
            "title": "Points"
          },
          "units": {
            "type": "string",
            "enum": [
              "mm",
              "pixels"
            ],
            "title": "Units"
          },
          "text": {
            "type": "string",
            "maxLength": 4096,
            "title": "Text",
            "default": ""
          },
          "state": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "id",
          "series_uid",
          "instance_id",
          "frame",
          "tool",
          "points",
          "units"
        ],
        "title": "Annotation"
      },
      "Body_import_files_api_v1_imports_post": {
        "properties": {
          "files": {
            "items": {
              "type": "string",
              "format": "binary"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "files"
        ],
        "title": "Body_import_files_api_v1_imports_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportErrorResponse": {
        "properties": {
          "file": {
            "type": "string",
            "title": "File"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "file",
          "message"
        ],
        "title": "ImportErrorResponse"
      },
      "ImportResult": {
        "properties": {
          "imported": {
            "type": "integer",
            "title": "Imported"
          },
          "duplicates": {
            "type": "integer",
            "title": "Duplicates"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/ImportErrorResponse"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "imported",
          "duplicates",
          "errors"
        ],
        "title": "ImportResult"
      },
      "InstanceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "study_uid": {
            "type": "string",
            "title": "Study Uid"
          },
          "series_uid": {
            "type": "string",
            "title": "Series Uid"
          },
          "sop_uid": {
            "type": "string",
            "title": "Sop Uid"
          },
          "sop_class_uid": {
            "type": "string",
            "title": "Sop Class Uid"
          },
          "patient_name": {
            "type": "string",
            "title": "Patient Name"
          },
          "patient_id": {
            "type": "string",
            "title": "Patient Id"
          },
          "study_date": {
            "type": "string",
            "title": "Study Date"
          },
          "study_description": {
            "type": "string",
            "title": "Study Description"
          },
          "series_description": {
            "type": "string",
            "title": "Series Description"
          },
          "modality": {
            "type": "string",
            "title": "Modality"
          },
          "instance_number": {
            "type": "integer",
            "title": "Instance Number"
          },
          "rows": {
            "type": "integer",
            "title": "Rows"
          },
          "columns": {
            "type": "integer",
            "title": "Columns"
          },
          "frames": {
            "type": "integer",
            "title": "Frames"
          },
          "samples": {
            "type": "integer",
            "title": "Samples"
          },
          "photometric": {
            "type": "string",
            "title": "Photometric"
          },
          "position": {
            "anyOf": [
